bin_PROGRAMS = scalpel3 blockmapfs scalpel3-ctl fragmentator crblockmap modblockmap cmpblockmaps mergeblockmap dumphf diskviz

ONNXRUNTIME_LIBDIR ?= /usr/local/lib
ONNXRUNTIME_RPATH = -Wl,-rpath,$(ONNXRUNTIME_LIBDIR)

scalpel3_CFLAGS = -Wno-deprecated-declarations -Wmissing-prototypes -Wextra -Wall -Wstrict-prototypes \
                  -O3 -g -I/opt/local/include -DSIMDE_ENABLE_OPENMP -fopenmp-simd -march=native -mtune=native

scalpel3_CXXFLAGS = -std=c++17 -O3 -g -Wextra -Wall -march=native -mtune=native
scalpel3_CPPFLAGS = $(CPPFLAGS)

scalpel3_ctl_CFLAGS = -O2 -g -Wno-deprecated-declarations -Wmissing-prototypes -Wextra -Wall -Wstrict-prototypes -I/opt/local/include -fopenmp-simd -march=native -mtune=native

modblockmap_CFLAGS = -Wno-deprecated-declarations -Wmissing-prototypes -Wextra -Wall -Wstrict-prototypes -I /opt/local/include -O3 -g -fopenmp-simd -march=native -mtune=native

crblockmap_CFLAGS = -Wno-deprecated-declarations -Wmissing-prototypes -Wextra -Wall -Wstrict-prototypes -I /opt/local/include -O3 -g -DSIMDE_ENABLE_OPENMP -fopenmp-simd -march=native -mtune=native

cmpblockmap_CFLAGS = -Wno-deprecated-declarations -Wmissing-prototypes -Wextra -Wall -Wstrict-prototypes -O3 -g -fopenmp-simd -march=native -mtune=native

fragmentator_CFLAGS = -Wno-deprecated-declarations -Wmissing-prototypes -Wextra -Wall -Wstrict-prototypes -I /opt/local/include -O3 -g -fopenmp-simd -march=native -mtune=native

mergeblockmap_CFLAGS = -Wno-deprecated-declarations -Wmissing-prototypes -Wextra -Wall -Wstrict-prototypes -O2 -g -fopenmp-simd -march=native -mtune=native

blockmapfs_CPPFLAGS = -D_FILE_OFFSET_BITS=64
blockmapfs_CFLAGS   = -Wno-deprecated-declarations -Wmissing-prototypes -Wextra -Wall -Wstrict-prototypes -O3 -g -I /opt/local/include $(FUSE_CFLAGS) -fopenmp-simd -march=native -mtune=native
blockmapfs_LDADD    = $(FUSE_LIBS)

scalpel3_SOURCES = scalpel.c scalpelconf.c filemirror.c carve.c util.c prioque.c base_name.c blockmap.c reassembly.c colors.c roaring.c hashv4.c scalpelsimd.c dedup.c common.c \
	exe_vision/unix/elf_seg_onnx.cpp exe_vision/unix/elf_seg_onnx_cabi.cpp exe_vision/unix/elf_onnx_global.c *.h

scalpel3_ctl_SOURCES = scalpel3-ctl.c blockmap.c colors.c prioque.c  hashv4.c dedup.c common.c *.h

blockmapfs_SOURCES = blockmapfs.c blockmap.c blockmap.h hashv4.c colors.c dedup.c common.c prioque.c *.h

crblockmap_SOURCES = crblockmap.c blockmap.c blockmap.h colors.c hashv4.c dedup.c common.c prioque.c *.h

cmpblockmaps_SOURCES = cmpblockmaps.c blockmap.c blockmap.h hashv4.c colors.c dedup.c common.c prioque.c *.h

modblockmap_SOURCES = modblockmap.c blockmap.c blockmap.h hashv4.c colors.c dedup.c common.c prioque.c *.h

fragmentator_SOURCES = fragmentator.c colors.c longsset.c common.c prioque.c *.h

mergeblockmap_SOURCES = mergeblockmap.c blockmap.c blockmap.h colors.c hashv4.c dedup.c common.c prioque.c *.h

dumphf_SOURCES = dumphf.c colors.c common.c prioque.c *.h

diskviz_CFLAGS = -Wno-deprecated-declarations -Wmissing-prototypes -Wextra -Wall -Wstrict-prototypes -O2 -g \
                 @SDL2_CFLAGS@ @SDL2_IMAGE_CFLAGS@ @SDL2_TTF_CFLAGS@
diskviz_SOURCES = diskviz.c colors.c hashv4.c common.c prioque.c *.h


scalpel3_LDFLAGS  = $(LDFLAGS) -L$(ONNXRUNTIME_LIBDIR) -Wl,-rpath,$(ONNXRUNTIME_LIBDIR)
scalpel3_LDADD    = -lonnxruntime

fragmentator_LDFLAGS = $(LDFLAGS)
blockmapfs_LDFLAGS   = $(LDFLAGS)
scalpel3_ctl_LDFLAGS = $(LDFLAGS)
crblockmap_LDFLAGS   = $(LDFLAGS)
modblockmap_LDFLAGS  = $(LDFLAGS)
cmpblockmaps_LDFLAGS = $(LDFLAGS)
mergeblockmap_LDFLAGS= $(LDFLAGS)
dumphf_LDFLAGS= $(LDFLAGS)
diskviz_LDFLAGS = $(LDFLAGS) @SDL2_LIBS@ @SDL2_IMAGE_LIBS@ @SDL2_TTF_LIBS@

all:	      all-am
