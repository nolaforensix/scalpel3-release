bin_PROGRAMS = scalpel3 blockmapfs scalpel3-ctl fragmentator crblockmap modblockmap cmpblockmaps dumphf diskviz

ONNXRUNTIME_LIBDIR = /usr/local/lib

LIBS += -lz -ldl -luuid

scalpel3_CFLAGS = -Wno-format-truncation -Wno-deprecated-declarations -no-pie -Wmissing-prototypes -Wstrict-prototypes -Wextra -Wall -O3 -g -DSIMDE_ENABLE_OPENMP -fopenmp-simd -march=native -mtune=native

scalpel3_ctl_CFLAGS = -Wno-deprecated-declarations -Wmissing-prototypes -Wextra -Wall -Wstrict-prototypes -O2 -g -fopenmp-simd -march=native -mtune=native
RPATH_LDFLAGS = -Wl,-rpath,$(ONNXRUNTIME_LIBDIR)
scalpel3_CXXFLAGS = -std=c++17 -O3 -g -Wextra -Wall -march=native -mtune=native
scalpel3_CPPFLAGS = $(CPPFLAGS)
scalpel3_LDADD = -lonnxruntime

modblockmap_CFLAGS = -Wno-deprecated-declarations -Wmissing-prototypes -Wextra -Wall -Wstrict-prototypes -O2 -g -fopenmp-simd -march=native -mtune=native

crblockmap_CFLAGS = -Wno-deprecated-declarations -Wmissing-prototypes -Wextra -Wall -Wstrict-prototypes -O2 -g -DSIMDE_ENABLE_OPENMP -fopenmp-simd -march=native -mtune=native

cmpblockmap_CFLAGS = -Wno-deprecated-declarations -Wmissing-prototypes -Wextra -Wall -Wstrict-prototypes -O2 -g -fopenmp-simd -march=native -mtune=native

fragmentator_CFLAGS = -Wno-deprecated-declarations -Wmissing-prototypes -Wextra -Wall -Wstrict-prototypes -O2 -g -fopenmp-simd -march=native -mtune=native

blockmapfs_CPPFLAGS = -D_FILE_OFFSET_BITS=64 $(FUSE_CFLAGS)
blockmapfs_CFLAGS = -Wno-deprecated-declarations -Wmissing-prototypes -Wextra -Wall -Wstrict-prototypes -O2 -g -fopenmp-simd -ffunction-sections -fdata-sections -march=native -mtune=native
blockmapfs_LDADD = $(FUSE_LIBS)

scalpel3_SOURCES = scalpel.c scalpelconf.c filemirror.c carve.c util.c prioque.c base_name.c blockmap.c reassembly.c colors.c roaring.c hashv4.c scalpelsimd.c dedup.c common.c exe_vision/unix/elf_onnx.cpp exe_vision/unix/elf_onnx_global.c *.h modico.c modico_onnx_global.c modico_classmap.c gpu_meminfo.c onnx_providers.c

scalpel3_ctl_SOURCES = scalpel3-ctl.c blockmap.c colors.c prioque.c hashv4.c dedup.c common.c *.h

blockmapfs_SOURCES = blockmapfs.c blockmap.c blockmap.h hashv4.c colors.c dedup.c common.c prioque.c *.h

crblockmap_SOURCES = crblockmap.c blockmap.c blockmap.h colors.c hashv4.c dedup.c common.c prioque.c *.h

cmpblockmaps_SOURCES = cmpblockmaps.c blockmap.c blockmap.h hashv4.c colors.c dedup.c common.c prioque.c *.h

modblockmap_SOURCES = modblockmap.c blockmap.c blockmap.h hashv4.c colors.c dedup.c common.c prioque.c *.h

fragmentator_SOURCES = fragmentator.c colors.c longsset.c common.c prioque.c *.h

dumphf_SOURCES = dumphf.c colors.c common.c prioque.c *.h

diskviz_CFLAGS = -Wno-deprecated-declarations -Wmissing-prototypes -Wextra -Wall -Wstrict-prototypes -O2 -g \
                 @SDL2_CFLAGS@ @SDL2_IMAGE_CFLAGS@ @SDL2_TTF_CFLAGS@
diskviz_SOURCES = diskviz.c diskviz_index.c colors.c hashv4.c common.c prioque.c *.h

scalpel3_LDFLAGS = $(LDFLAGS) -L$(ONNXRUNTIME_LIBDIR) -Wl,-rpath,$(ONNXRUNTIME_LIBDIR)

fragmentator_LDFLAGS = $(LDFLAGS)
blockmapfs_LDFLAGS = $(LDFLAGS) -Wl,--gc-sections -Wl,--as-needed
scalpel3_ctl_LDFLAGS = $(LDFLAGS)
crblockmap_LDFLAGS = $(LDFLAGS)
modblockmap_LDFLAGS = $(LDFLAGS)
cmpblockmaps_LDFLAGS = $(LDFLAGS)
dumphf_LDFLAGS = $(LDFLAGS)
diskviz_LDFLAGS = $(LDFLAGS)
diskviz_LDADD = @SDL2_LIBS@ @SDL2_IMAGE_LIBS@ @SDL2_TTF_LIBS@

all: all-am
