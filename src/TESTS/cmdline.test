#!/usr/bin/env bash

# This simple test involves a small number of files and mild fragmentation.  It should run in a few
# minutes on a fast machine and there should be 100% recovery accuracy.  If you encounter any
# situations where this isn't the case, please contact the authors via golden@cct.lsu.edu!
#
# Wrapper flags consumed by this script (NOT passed through to scalpel3 alone):
#
#   -q <blocksize>   Override the block/cluster size.  Forwarded to fragmentator, crblockmap,
#                    and scalpel3.  Default: 16384.
#
#   -c               Turn fragmentation OFF.  Forwarded to fragmentator (-c, strip all
#                    fragmentation directives) and to scalpel3 (-c, NO_DEFRAG).  Not forwarded
#                    to crblockmap.
#
#   --fragmentator   All following arguments are passed to fragmentator only.
#
# Any other arguments before --fragmentator are passed through verbatim to scalpel3 only.

Q_VAL="16384"
NOFRAG=0
SCALPEL_ARGS=()
FRAGMENTATOR_ARGS=()
HAS_Z_FILTER=0
FRAGMENTATOR_MODE=0

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Parse the arguments.
while [[ $# -gt 0 ]]; do
    if [[ "$FRAGMENTATOR_MODE" -eq 1 ]]; then
        FRAGMENTATOR_ARGS+=("$1")
        shift 1
        continue
    fi

    case "$1" in
        -q)
            Q_VAL="$2"
            shift 2
            ;;
        -c)
            NOFRAG=1
            shift 1
            ;;
        --fragmentator)
            FRAGMENTATOR_MODE=1
            shift 1
            ;;
        -z)
            HAS_Z_FILTER=1
            SCALPEL_ARGS+=("$1")
            shift 1
            ;;
        *)
            SCALPEL_ARGS+=("$1")
            shift 1
            ;;
    esac
done

cd "$SRC_DIR" || exit 1

Q_ARG="-q $Q_VAL"

FRAG_NOFRAG_ARG=()
SCALPEL_NOFRAG_ARG=()
if [[ "$NOFRAG" -eq 1 ]]; then
    FRAG_NOFRAG_ARG=("-c")
    SCALPEL_NOFRAG_ARG=("-c")
fi

# Regenerate the synthetic fixtures used by the selected test description at the current blocksize.

python3 generate-abc-file.py TESTS/file.abc  "$Q_VAL"   &&\
python3 generate-abc-file.py TESTS/file2.abc "$Q_VAL"   &&\
python3 generate-123-file.py TESTS/file.123  "$Q_VAL" 1 &&\
python3 generate-123-file.py TESTS/file2.123 "$Q_VAL" 2 &&\
python3 generate-csv-file.py TESTS/test.csv "$Q_VAL" || { echo "fixture regeneration failed" >&2; exit 1; }

if grep -Eq '^[[:space:]]*FILE:[[:space:]]*TESTS/test\.sqlite([[:space:]]|$)' TESTS/test.frg; then
    python3 generate-sqlite-file.py TESTS/test.sqlite "$Q_VAL" || {
        echo "SQLite fixture regeneration failed" >&2
        exit 1
    }
fi

# These lines simply ensure that the run starts from scratch, by removing any prior scalpel-output
# directory, the blockmap file generated by crblockmap, and the image file generated by
# fragmentator.

rm -rf scalpel-output
rm TESTS/test.img.blockmap
rm TESTS/test.img

# fragmentator creates a synthetic disk image based on the template test.frg

# crblockmap creates an essential scalpel3 data structure:  a blockmap for the image file.

# After scalpel3 executes, this script evalutes scalpel3 accuracy by comparing to the ground truth
# files used by fragmentator.

set -x
./fragmentator $Q_ARG "${FRAG_NOFRAG_ARG[@]}" "${FRAGMENTATOR_ARGS[@]}" -o TESTS/test.img TESTS/test.frg &&\
./crblockmap $Q_ARG TESTS/test.img TESTS/test.img.blockmap &&\
if [[ "$HAS_Z_FILTER" -eq 1 ]]; then
    ./scalpel3 "${SCALPEL_ARGS[@]}" "${SCALPEL_NOFRAG_ARG[@]}" $Q_ARG -b -o scalpel-output TESTS/test.img TESTS/test.img.blockmap
else
    ./scalpel3 "${SCALPEL_ARGS[@]}" "${SCALPEL_NOFRAG_ARG[@]}" $Q_ARG -w -b -o scalpel-output TESTS/test.img TESTS/test.img.blockmap
fi &&\
test -s scalpel-output/blockclassification.dat &&\
./validate_blockvectors_fast.py --verbose --require-all-exact --fail-on-invalid-validated \
    --key TESTS/test.img.key --scalpel-dir scalpel-output --frg TESTS/test.frg \
    --blockmap TESTS/test.img.blockmap
rc=$?
set +x
exit $rc
