# This simple test involves a small number of files and mild fragmentation.  It should run in a few
# minutes on a fast machine and there should be 100% recovery accuracy.  If you encounter any
# situations where this isn't the case, please contact the authors via golden@cct.lsu.edu!  You can use
# -q <blocksize> to override blocksize.

# This block isolates all command line arguments except "-q" from fragmentator and crblockmap.

Q_VAL="16384"
SCALPEL_ARGS=()
HAS_Z_FILTER=0

# 2. Parse the arguments
while [[ $# -gt 0 ]]; do
    if [[ "$1" == "-q" ]]; then
        Q_VAL="$2"
        shift 2  # Consume both "-q" and its value so they don't go into SCALPEL_ARGS
    else
        if [[ "$1" == "-z" ]]; then
            HAS_Z_FILTER=1
        fi
        SCALPEL_ARGS+=("$1")
        shift 1  # Consume the argument, saving it to SCALPEL_ARGS
    fi
done

# Reconstruct the exact flag needed for the utilities
Q_ARG="-q $Q_VAL"

# These lines simply ensure that the run starts from scratch, by removing any prior scalpel-output
# directory, the blockmap file generated by crblockmap, and the image file generated by
# fragmentator.

rm -rf scalpel-output
rm TESTS/test.img.blockmap
rm TESTS/test.img

# fragmentator creates a synthetic disk image based on the template test.frg

# crblockmap creates an essential scalpel3 data structure:  a blockmap for the image file.

# After scalpel3 executes, this script evalutes scalpel3 accuracy by comparing to the ground truth
# files used by fragmentator.

set -x
./fragmentator $Q_ARG -o TESTS/test.img TESTS/test.frg &&\
./crblockmap $Q_ARG TESTS/test.img TESTS/test.img.blockmap &&\
if [[ "$HAS_Z_FILTER" -eq 1 ]]; then
    ./scalpel3 "${SCALPEL_ARGS[@]}" $Q_ARG -b -o scalpel-output TESTS/test.img TESTS/test.img.blockmap
else
    ./scalpel3 "${SCALPEL_ARGS[@]}" $Q_ARG -b -U csv -o scalpel-output TESTS/test.img TESTS/test.img.blockmap
fi &&\
./validate_blockvectors_fast.py --verbose --key TESTS/test.img.key --scalpel-dir scalpel-output --frg TESTS/test.frg --blockmap TESTS/test.img.blockmap
rc=$?
set +x
exit $rc
